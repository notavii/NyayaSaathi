# Streamlit Secrets Configuration for Nyaya Saathi
# -------------------------------------------------------------
# INSTRUCTIONS FOR LOCAL DEVELOPMENT:
# 1. Copy this file to a new file named 'secrets.toml' in this same directory (.streamlit/).
# 2. Replace the placeholder values with your actual Gemini API key obtained from Google AI Studio.
# 3. IMPORTANT: Never commit 'secrets.toml' to Git or version control!
#    It is already listed in .gitignore to protect your key.
# -------------------------------------------------------------

GEMINI_API_KEY = "YOUR_ACTUAL_KEY"
GEMINI_MODEL = "gemini-3.1-flash-lite"
